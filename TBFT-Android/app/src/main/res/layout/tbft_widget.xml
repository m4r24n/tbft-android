<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TBFT · TODAY"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="Open TBFT once to connect"
        android:textColor="#A6FFFFFF"
        android:textSize="11sp" />

    <TextView android:id="@+id/task1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#F2FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/task2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#F2FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/task3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#F2FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/task4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#F2FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/task5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#F2FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/task6" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#F2FFFFFF" android:textSize="14sp" />

    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="Open TBFT once to connect"
        android:textColor="#BFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Updates automatically every 30 min"
        android:textColor="#7FFFFFFF"
        android:textSize="10sp" />
</LinearLayout>
